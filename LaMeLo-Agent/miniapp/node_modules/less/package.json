{
  "name": "less",
  "version": "4.0.0",
  "description": "Leaner Less",
  "main": "lib/less-node/less.js",
  "bin": {
    "lessc": "bin/lessc",
    "less": "bin/less",
    "lessc-1": "bin/lessc-1",
    "less-1": "bin/less-1"
  },
  "files": [
    "bin",
    "lib",
    "index.js",
    "package.json",
    "README.md",
    "LICENSE",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --recursive test/unit",
    "test:integration": "mocha --recursive test/integration",
    "pretest": "npm run clean",
    "clean": "rimraf lib lib-cov",
    "prepublishOnly": "npm run build",
    "build": "npm run clean && npm run build:lib",
    "build:lib": "babel lib --out-dir lib-cov && mkdir -p lib && mv lib-cov/lib/* lib && rmdir lib-cov/lib lib-cov && node -e 'console.log(\"Built successfully\")'",
    "postinstall": "node --version",
    "prebuild:lib": "rimraf lib",
    "postbuild:lib": "node -e \"console.log(require('./package.json').files) | xargs rimraf\"",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "coverage": "nyc --reporter=html --reporter=text npm test",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "npm run docs -- -w"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/less/less.js.git"
  },
  "keywords": [
    "less",
    "css",
    "preprocessor",
    "css3"
  ],
  "author": "Alexis Ashton <alexis@leancrew.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/less/less.js/issues"
  },
  "homepage": "http://lesscss.org",
  "dependencies": {
    "copy-anything": "^2.0.0",
    "parse-node-version": "^1.0.0",
    "timers-browserify": "^2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "babel-preset-minify": "^0.5.0",
    "chai": "^4.0.0",
    "chai-spies": "^1.0.0",
    "eslint": "^8.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "jsdoc": "^4.0.0",
    "jsdoc-to-markdown": "^8.0.0",
    "mocha": "^10.0.0",
    "nyc": "^15.0.0",
    "rimraf": "^3.0.0",
    "standard": "^17.0.0",
    "supertest": "^6.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "types": "index.d.ts",
  "directories": {
    "test": "test"
  },
  "browser": {
    "fs": false,
    "path": false
  },
  "main": "lib/less-node/less.js"
}