{
  "name": "element-plus",
  "version": "2.4.0",
  "description": "Element Plus is an element-style component library for Vue 3",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:es && npm run build:cjs && npm run build:umd && npm run build:types",
    "clean": "rimraf dist",
    "build:es": "rollup -c scripts/build.es.js",
    "build:cjs": "rollup -c scripts/build.cjs.js",
    "build:umd": "rollup -c scripts/build.umd.js",
    "build:types": "tsc -p scripts/tsconfig.json",
    "dev": "rollup -c scripts/build.es.js --watch"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.0",
    "@types/lodash": "^4.14.0",
    "@types/node": "^16.0.0",
    "lodash": "^4.17.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-vue": "^4.0.0",
    "@types/lodash": "^4.14.0",
    "@types/node": "^16.0.0",
    "babel-preset-minify": "^0.5.0",
    "eslint": "^8.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "rimraf": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-plus/element-plus.git"
  },
  "keywords": [
    "element-plus",
    "vue",
    "ui",
    "component"
  ],
  "author": "Element Plus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/element-plus/element-plus/issues"
  },
  "homepage": "https://github.com/element-plus/element-plus#readme",
  "types": "index.d.ts"
}