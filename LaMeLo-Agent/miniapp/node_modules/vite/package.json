{
  "name": "vite",
  "version": "5.0.0",
  "description": "Vite is a modern web development build tool",
  "main": "dist/node/cli.js",
  "bin": {
    "vite": "bin/vite.js"
  },
  "files": [
    "dist",
    "bin",
    "index.js"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js -w",
    "test": "node scripts/test.js",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --fix",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "test-e2e": "node scripts/test-e2e.js",
    "test-unit": "node scripts/test-unit.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "esbuild": "^0.19.0",
    "postcss": "^8.4.0",
    "resolve": "^1.22.0",
    "rollup": "^4.0.0",
    "source-map": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/resolve": "^1.20.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "esbuild": "^0.19.0",
    "postcss": "^8.4.0",
    "resolve": "^1.22.0",
    "rollup": "^4.0.0",
    "source-map": "^0.6.1"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vitejs/vite.git"
  },
  "license": "MIT"
}