{
  "name": "autoprefixer",
  "version": "10.4.0",
  "description": "Parse CSS and add vendor prefixes",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postcss/autoprefixer.git"
  },
  "scripts": {
    "test": "mocha",
    "test:ci": "mocha --reporter=min",
    "prepublishOnly": "npm run build",
    "build": "npm run build:js && npm run build:types",
    "build:js": "babel src --out-dir .",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir . --moduleResolution node --module commonjs --allowSyntheticDefaultImports --noImplicitAny --strict --allowJs --checkJs false --target es5 --allowUnreachableCode false --allowUnusedLabels false --noFallthroughCasesInSwitch false --noUnusedLocals false --noUnusedParameters false --skipLibCheck true --noImplicitThis false --noImplicitReturns false --noImplicitAny false --strictNullChecks false src/index.js",
    "prebuild:types": "rimraf index.d.ts",
    "postbuild:types": "node -e 'console.log(require(\"./package.json\").files)' | xargs rimraf"
  },
  "dependencies": {
    "browserslist": "^4.21.0",
    "caniuse-lite": "^1.0.0",
    "colorette": "^1.2.1",
    "fraction.js": "^4.1.0",
    "normalize-range": "^0.1.2",
    "postcss": "^8.4.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-preset-minify": "^0.5.0",
    "eslint": "^8.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "mocha": "^10.0.0",
    "rimraf": "^3.0.0",
    "standard": "^17.0.0",
    "supertest": "^6.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "package.json",
    "readme.md",
    "LICENSE"
  ],
  "bin": {
    "autoprefixer": "bin/autoprefixer"
  },
  "engines": {
    "node": "^10 || ^12 || >=14"
  },
  "types": "index.d.ts",
  "homepage": "https://github.com/postcss/autoprefixer#readme"
}